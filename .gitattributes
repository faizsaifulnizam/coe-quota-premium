# CSV outputs are written with LF endings on every platform (src/analysis.py write_csv);
# keep the working tree LF so `git diff --quiet` and `git status` both stay clean
# after a regeneration, on Windows and Unix alike.
*.csv text eol=lf
# Frozen source and original manifest hashes refer to exact bytes, not normalized text.
data/raw/coe-bidding-results.csv -text
data/raw/pull_manifest.json -text
